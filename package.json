{
  "name": "universal-payment-gateway",
  "version": "2.0.0",
  "type": "module",
  "description": "Universal Sovereign Payment Gateway & Banking Observer — Zero-Fee P2P checkout for bKash, Nagad, Rocket, UPI, Cards & PayPal with automated real-time SMS reconciliation",
  "private": true,
  "homepage": "https://github.com/fsferdows/universal-payment-gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsferdows/universal-payment-gateway.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.js",
    "db:setup": "node scripts/init-db.cjs",
    "sync:package": "node scripts/sync-package.cjs",
    "start": "node scripts/start.js",
    "start:prod": "node scripts/start.js",
    "start:prod:api": "node apps/payment-api/src/index.js",
    "start:stripe": "node apps/stripe-gateway/src/index.js",
    "dev": "node scripts/dev.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:acceptance": "node --test scripts/production-infrastructure.test.js",
    "build:android:apk": "node scripts/build-android-apk.js",
    "sync:android-allowlist": "node scripts/sync-android-allowlist.js",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "FS FERDOWS <fsferdows@icloud.com> (https://github.com/fsferdows)",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true
  },
  "dependencies": {
    "stripe": "^23.1.0"
  }
}
